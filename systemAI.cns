trigger1 = command = "holdfwd_sys"
sysvar(2) = 1

[State ]
type = VarSet
trigger1 = command = "holdback_sys"
sysvar(2) = -1

[State ]
type = VelSet
trigger1 = 1
x = ifelse(sysvar(2) = 0, 0,ifelse(sysvar(2) = 1, const(velocity.walk.fwd.x)/3, ifelse(sysvar(2) = -1, const(velocity.walk.back.x)/3,const(velocity.run.fwd.x)/3)))
z = const(velocity.walk.fwd.x)/3*sysvar(1)

[State ]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim ! = 20 && Anim ! = 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State ]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim ! = 21 && Anim ! = 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State Stop Walking]
type = ChangeState
trigger1 = (command ! = "hold↑_sys" && command ! = "hold↓_sys") || (command = "hold↑_sys" && command = "hold↓_sys")
value = 0

