[Statedef -4]

[State ]
Type = ScreenBound
Trigger1 = RoundState = 0
Value = 0
movecamera = 0
IgnoreHitPause = 1

[State ]
type = VarSet
trigger1 = 1
AIVar(10) = !(root,AILevel+AILevel) && !InGuardDist && (abs(p2bodydist x)*LocalcoordScale>380 || abs(p2bodydist y)*LocalcoordScale>240 || abs(p2bodydist z)*LocalcoordScale>10)

[State ]
type = AssertSpecial
trigger1 = AIVar(10)
flag = NoAutoTurn

[State ]
type = turn
trigger1 = gametime%10 = 0 && ctrl && command = "holdback_sys" && AIVar(10)

[State ]
type = Explod
trigger1 = (MoveType = h||StateNo = 52)&&!HitFall&&(vel x>0.5||vel x<-0.5)&&pos y = 0&&BackEdgeBodyDist>0&&time%3 = 1
PosType = p1
anim = f120
sprpriority = 3
ownpal = 1

[State Jump]
type = ChangeState
triggerall = ctrl && roundstate = 2 && StateType = S && StateNo ! = 40 && StateNo ! = 22123456 && StateNo ! = 21123456 && command = "holdup_sys"；因为跳落地52，并按跳时，52会马上变成40所以不能加 && StateNo ! = 52
trigger1 = command ! = "hold↑_sys" && command ! = "hold↓_sys"
value = 40

[State Duck]
type = ChangeState
trigger1 = ctrl && StateNo ! = 10 && StateNo ! = 11 && StateNo ! = 52 && StateType = S && command = "holddown_sys"
value = 10

[State ]
type = ChangeState
trigger1 = ctrl && StateNo ! = 12 && StateType = C && command ! = "holddown_sys"
value = 12

[State Walk]
type = ChangeState
triggerall = ctrl && StateType = S && StateNo ! = 20 && StateNo ! = 21123456 && StateNo ! = 100
triggerall = StateNo < 120 || StateNo > 155 || !InGuardDist
triggerall = Assertion(NoWalk) = 0
trigger1 = command = "holdfwd_sys" && command ! = "holdback_sys"
trigger2 = command ! = "holdfwd_sys" && command = "holdback_sys"
value = 20

[State Walk21123456]
type = ChangeState
triggerall = ctrl && roundstate = 2 && StateType = S && StateNo ! = 21123456 && StateNo ! = 22123456 && StateNo ! = 52 && StateNo ! = 50 && StateNo ! = 40 && StateNo ! = 100 && StateNo ! = 23123456
trigger1 = command = "hold↑_sys" && command ! = "hold↓_sys"
trigger2 = command ! = "hold↑_sys" && command = "hold↓_sys"
value = 21123456

[State Jump22123456]
type = ChangeState
triggerall = ctrl && command = "holdup_sys" && roundstate = 2 && StateType = S && StateNo ! = 52 && StateNo ! = 50 && StateNo ! = 40 && StateNo ! = 22123456
trigger1 = command = "hold↑_sys" && command ! = "hold↓_sys"
trigger2 = command ! = "hold↑_sys" && command = "hold↓_sys"
value = 22123456

[State Air Jump]
type = ChangeState
trigger1 = ctrl && StateNo = 50 && command = "press up_sys"
trigger1 = Pos Y < = -1 * Const(movement.airjump.height)
trigger1 = sysvar(2) < Const(movement.airjump.num)
value = 45

[State Run]
type = ChangeState
trigger1 = StateNo ! = 100 && (command = "hold→_sys"||command = "hold←_sys") && statetype = S && ctrl
value = 100

[State Landing]
