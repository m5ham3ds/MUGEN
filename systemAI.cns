[Statedef 21123456]
type = S
physics = S
anim = 20
sprpriority = 1

[State ]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State ]
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0

