;-------------------------modifications-------------------------
[Statedef -2]

[State ] ;quick restart
type = MatchReStart
trigger1 = GameMode = "Training" && command = "hold∨RDown_sys" && TeamSide = 1 && AILevel = 0
trigger2 = GameMode = "Training" && command = "hold∨RDown_sys" && TeamSide = 2 && AILevel = 0
reload = 1

[State ] ;training layout p1
type = ChangeTouchButtonDef
trigger1 = GameMode = "Training" && RoundClockTime = 99
trigger2 = GameMode = "Training" && command = "hold＜RLeft_sys" && AILevel = 0
trigger3 = GameMode = "Training" && AILevel = 4 && TeamSide = 2
def = touch/trainingP1.def

[State ] ;training layout p2
type = ChangeTouchButtonDef
trigger1 = GameMode = "Training" && command = "hold＞RRight_sys" && AILevel = 0
trigger2 = GameMode = "Training" && AILevel = 4 && TeamSide = 1
def = touch/trainingP2.def

[State ] ;versus layout
type = ChangeTouchButtonDef
trigger1 = GameMode = "Arcade"
trigger2 = GameMode = "Versus"
trigger3 = GameMode = "TeamVersus"
def = touch/versus.def

[State ] ;watch layout
type = ChangeTouchButtonDef
trigger1 = GameMode = "Watch"
def = touch/watch.def

[State ] ;training layout p1 ALT
type = ChangeTouchButtonDef
trigger1 = GameMode = "Training" && RoundClockTime = 99
trigger2 = GameMode = "Training" && command = "hold＜RLeft_sys" && AILevel = 0
trigger3 = GameMode = "Training" && AILevel = 4 && TeamSide = 2
def = touch/touchALT/trainingP1.def

[State ] ;training layout p2 ALT
type = ChangeTouchButtonDef
trigger1 = GameMode = "Training" && command = "hold＞RRight_sys" && AILevel = 0
trigger2 = GameMode = "Training" && AILevel = 4 && TeamSide = 1
def = touch/touchALT/trainingP2.def

[State ] ;versus layout ALT
type = ChangeTouchButtonDef
trigger1 = GameMode = "Arcade"
trigger2 = GameMode = "Versus"
trigger3 = GameMode = "TeamVersus"
def = touch/touchALT/versus.def

