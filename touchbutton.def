;----------------------------------------------------------------
[TouchButtondef]
WaitTime = 200
ShowPressed = 1
BasePanelWidth = 852
FlipY = 0
;----------------------------------------------------------------
[Defaults]
Button.Width = 60
Button.Height = 60
Button.BorderWidth = 1
Button.ReleasedBorderColor = 255,255,255,127
Button.ReleasedFillColor = 255,255,255,0
Button.PressedBorderColor = 255,255,255,127
Button.PressedFillColor = 255,255,255,127
Button.AgainTime = 10000
Button.TouchArea = 40,40
;-----------------------------------------------------------------
;Reads textures from CQJ.Libs/FormXTextures/touchbutton
;Images resolution should be the same as the buttons x & y
;eg:
;Width = 50
;Height = 50
;then the image size should be 50x50

;Lines for adding textures to buttons
----------Main----------
;PressedSprite = mybuttonPressed.png
;ReleasedSprite = mybuttonReleased.png

----------Misc----------
;PressedFillColor = 0,0,0,0
;PressedBorderColor = 0,0,0,0
;PressedSpriteOffset = 0,0
;ReleasedFillColor = 0,0,0,0
;ReleasedBorderColor = 0,0,0,0
;ReleasedSpriteOffset = 0,0

;To make a command for p2 add "Input = 1" below [Button]
;eg:
;[Button]
;Input = 1
;X = 100
;Y = 100
;Command = ?
;Width = 25
;Height = 25

